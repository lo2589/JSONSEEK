{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lo2589/jsonseek",
  "title": "jsonseek",
  "description": "Inspect, query and patch large JSON/JSONL files by path without reading the whole file.",
  "repository": {
    "url": "https://github.com/lo2589/JSONSEEK",
    "source": "github"
  },
  "version": "0.1.7",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "jsonseek",
      "version": "0.1.7",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
